CREATE TABLE `Chambres`(
    `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    `numero` BIGINT NOT NULL,
    `etages` BIGINT NOT NULL,
    `date_entree` DATETIME NOT NULL,
    `date_sortie` DATETIME NOT NULL,
    `NbLits` BIGINT NOT NULL
);
CREATE TABLE `Lit`(
    `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    `Occupations` BOOLEAN NOT NULL,
    `numero_Chambres` BIGINT NOT NULL
);
CREATE TABLE `Classes`(
    `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT PRIMARY KEY,
    `numeroClasse` BIGINT NOT NULL,
    `etages_Chambres` BIGINT NOT NULL
);
ALTER TABLE
    `Classes` ADD CONSTRAINT `classes_etages_chambres_foreign` FOREIGN KEY(`etages_Chambres`) REFERENCES `Chambres`(`etages`);
ALTER TABLE
    `Lit` ADD CONSTRAINT `lit_numero_chambres_foreign` FOREIGN KEY(`numero_Chambres`) REFERENCES `Chambres`(`numero`);
